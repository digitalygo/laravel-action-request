{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "final_class": true,
        "final_public_method_for_abstract_class": true,
        "protected_to_private": true,
        "native_function_invocation": {
            "include": ["@compiler_optimized"],
            "scope": "namespaced",
            "strict": true
        }
    }
}
